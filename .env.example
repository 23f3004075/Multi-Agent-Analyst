# ─────────────────────────────────────────────────────────
# Enterprise SQL Agent — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# ── LLM Provider API Keys ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Tier 1 (Local SLM) ──
TIER1_MODEL=ollama/qwen2.5-coder:3b
TIER1_FALLBACK_MODEL=gpt-4o-mini
TIER1_MAX_LATENCY_MS=5000
OLLAMA_API_BASE=http://localhost:11434

# ── Tier 2 (Frontier) ──
TIER2_MODEL=claude-sonnet-4-20250514

# ── Database ──
DATABASE_PATH=data/analytics.duckdb
DB_MEMORY_LIMIT=512MB
DB_MAX_THREADS=2
DB_QUERY_TIMEOUT_SECONDS=5.0
DB_MAX_RESULT_ROWS=5001

# ── Router ──
ROUTER_CONFIDENCE_THRESHOLD=0.65
SCHEMA_LINKER_TOP_K=3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Self-Healing ──
MAX_RETRIES=2

# ── Guardrails ──
NEMO_CONFIG_PATH=src/guardrails/nemo_config

# ── Reports ──
REPORT_OUTPUT_DIR=outputs/reports
CHART_OUTPUT_DIR=outputs/charts

# ── Cache ──
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# ── Observability ──
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Application ──
LOG_LEVEL=INFO
ENVIRONMENT=development
